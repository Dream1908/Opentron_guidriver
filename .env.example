# ── PUDA core ──────────────────────────────────────────────────────────────
NATS_SERVERS=nats://bears:4222,nats://bears:4223,nats://bears:4224
MACHINE_ID=ot2-1

# ── Opentrons GUI driver ────────────────────────────────────────────────────

# Window title of the Opentrons desktop App (usually just "Opentrons").
TARGET_APP=Opentrons

# Display name of the OT-2 robot in the Opentrons App robot list.
# Leave empty to auto-select the first available robot.
ROBOT_NAME=

# Seconds between automatic run_status telemetry captures.
# Lower values = more vision calls. Minimum recommended: 10.0
CAPTURE_INTERVAL=15.0
