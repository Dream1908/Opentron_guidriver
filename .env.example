# ── PUDA core ──────────────────────────────────────────────────────────────
NATS_SERVERS=nats://bears:4222,nats://bears:4223,nats://bears:4224
MACHINE_ID=my-instrument

# ── GUI driver ─────────────────────────────────────────────────────────────

# Exact window / application name cua-driver should target.
# This is the title of the instrument's control software window, e.g.:
#   Chromeleon, ChemStation, Xcalibur, OpenLAB CDS, EtherCAT, Notepad
TARGET_APP=InstrumentSoftwareName

# Seconds between automatic instrument_status telemetry captures.
# Lower values = more LLM API calls and tokens. Minimum recommended: 10.0
CAPTURE_INTERVAL=30.0
